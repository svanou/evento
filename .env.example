# Copier vers .env.local sans écraser un fichier existant. Ne jamais committer de secret.
APP_URL=http://127.0.0.1:3000
DATA_DIR=.data
# Accès local uniquement ; choisir son propre mot de passe. Désactivé sur Vercel.
ADMIN_AUTH_MODE=local
DEV_ADMIN_PASSWORD=
# En hébergement : PostgreSQL persistant, migrations 001, 002 puis 003.
# DATABASE_URL=
# PGSSLROOTCERT=/chemin/vers/ca.crt
# SESSION_SECRET=secret-aleatoire-d-au-moins-32-caracteres
# ADMIN_AUTH_MODE=supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ADMIN_USER_IDS=uuid-administrateur

# Recherche réelle sur Vercel. Aucun contenu de remplacement sans configuration.
# OPENAI_API_KEY=
# OPENAI_MODEL=
PREPARATION_TIMEOUT_MS=45000
PREPARATION_MAX_ATTEMPTS=3
SCHEDULER_ENABLED=false
# Vercel Production : secret aléatoire distinct, au moins 32 caractères, jamais NEXT_PUBLIC_.
# CRON_SECRET=

# Les confirmations et diffusions restent désactivées jusqu’à activation explicite.
EMAIL_MODE=disabled
# RESEND_API_KEY=
# EMAIL_FROM=Evento <newsletter@votre-domaine.fr>
EMAIL_TEST_ALLOWLIST=
# Ouvrir l’indexation seulement lorsque les pages sont prêtes.
SEARCH_INDEXING_ENABLED=false
