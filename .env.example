# Aucune clé requise pour la première tranche. Copier vers .env.local.
APP_MODE=demo
APP_URL=http://127.0.0.1:3000
DATA_DIR=.data
# Facultatif : figer le calendrier fictif, sans modifier l’expiration des sessions.
# DEMO_REFERENCE_DATE=2026-10-09T06:00:00Z
# Démo locale uniquement. Modifier ce mot de passe pour un environnement partagé.
DEMO_ADMIN_PASSWORD=evento-demo-local
# Facultatif : PostgreSQL Supabase. Appliquer d'abord la migration SQL.
# DATABASE_URL=
# PGSSLROOTCERT=/chemin/vers/certificat-ca-du-projet.crt
# Supabase Auth pour l'administrateur (hors démo)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ADMIN_USER_IDS=uuid-de-l-administrateur
# SESSION_SECRET=valeur-aleatoire-d-au-moins-32-caracteres
# Les adaptateurs réels seront activés dans une tranche ultérieure.
EMAIL_MODE=disabled
EMAIL_TEST_ALLOWLIST=
# OPENAI_MODEL=modele-a-valider-avec-la-documentation-officielle-au-lot-suivant
PREPARATION_MAX_CALLS=8
PREPARATION_TIMEOUT_MS=45000
PREPARATION_MAX_ATTEMPTS=3
SCHEDULER_ENABLED=false
